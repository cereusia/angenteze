{
  "version": 1,
  "transport": "local-contract",
  "tools": [
    {
      "name": "agenteze.prompt.echo",
      "description": "Contrato MCP local de baixo risco para validar o fluxo prompt -> backend -> resposta.",
      "category": "read",
      "risk": "low",
      "requires_confirmation": false,
      "enabled": true,
      "scope": {
        "workspace_bound": true,
        "network": false,
        "filesystem_write": false,
        "process_execution": false
      },
      "audit": {
        "input": "summary",
        "output": "summary",
        "store_events": true
      },
      "input_schema": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "agenteze.memory.capture_note",
      "description": "Contrato futuro para registrar uma nota na memoria local quando o usuario pedir explicitamente.",
      "category": "write",
      "risk": "medium",
      "requires_confirmation": true,
      "enabled": true,
      "activation": {
        "prompt_contains": [
          "gravar memoria",
          "salvar memoria",
          "registrar memoria",
          "guardar memoria"
        ]
      },
      "scope": {
        "workspace_bound": true,
        "network": false,
        "filesystem_write": true,
        "process_execution": false
      },
      "audit": {
        "input": "summary",
        "output": "summary",
        "store_events": true
      },
      "input_schema": {
        "type": "object",
        "required": ["note"],
        "properties": {
          "note": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  ]
}
