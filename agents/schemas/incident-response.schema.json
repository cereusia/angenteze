{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cereusia.local/schemas/incident-response.schema.json",
  "title": "R2D2 Incident Response break-glass",
  "$comment": "Structural schema. Identity, time, digest and transition checks require the semantic rules manifest and docs/security/R2D2_CANONICAL_DIGESTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_id", "revision", "state", "transition", "severity", "ownership", "scope", "credentials", "execution", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "incident_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["DRAFT", "AUTHORIZED", "ACTIVE", "CONTAINED", "RECOVERED", "CLOSED", "REVOKED"] },
    "transition": { "$ref": "#/$defs/stateTransition" },
    "severity": { "type": "string", "minLength": 1 },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_actions_digest_sha256", "executor_identity", "executor_must_differ_from_approvers", "roberto_approval", "tereza_approval"],
      "properties": {
        "scope_actions_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "executor_identity": { "type": "string", "minLength": 1 },
        "executor_must_differ_from_approvers": { "const": true },
        "roberto_approval": { "$ref": "#/$defs/robertoApproval" },
        "tereza_approval": { "$ref": "#/$defs/terezaApproval" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_lead", "production_owner", "security_assurance", "privacy_reviewer", "qa_reviewer"],
      "properties": {
        "incident_lead": { "const": "r2d2-global" },
        "production_owner": { "const": "tereza" },
        "security_assurance": { "const": "cristine" },
        "privacy_reviewer": { "type": "string", "minLength": 1 },
        "qa_reviewer": { "const": "eliane" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_digest_sha256", "canonicalization_version", "payload_type", "environment", "exact_assets", "excluded_assets", "allowed_actions", "prohibited_actions"],
      "properties": {
        "scope_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonicalization_version": { "const": "r2d2-c14n-v1" },
        "payload_type": { "const": "incident_scope_actions_v1" },
        "environment": { "type": "string", "minLength": 1 },
        "exact_assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "excluded_assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "allowed_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "prohibited_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "scopes", "issued_at", "expires_at", "revocation_owner", "values_must_not_be_recorded"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revocation_owner": { "type": "string", "minLength": 1 },
        "values_must_not_be_recorded": { "const": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "stop_at", "exact_commands_or_runbook", "independent_log_destination", "rollback_plan", "rollback_owner", "kill_switch"],
      "properties": {
        "start_at": { "type": "string", "format": "date-time" },
        "stop_at": { "type": "string", "format": "date-time" },
        "exact_commands_or_runbook": { "type": "string", "minLength": 1 },
        "independent_log_destination": { "type": "string", "minLength": 1 },
        "rollback_plan": { "type": "string", "minLength": 1 },
        "rollback_owner": { "const": "tereza" },
        "kill_switch": { "$ref": "#/$defs/killSwitch" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "personal_data", "doneda_gate", "evidence_location", "evidence_digest_sha256", "retention_until", "deletion_owner"],
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "personal_data": { "type": "boolean" },
        "doneda_gate": { "enum": ["PASS", "BLOCKED", "NOT_APPLICABLE"] },
        "evidence_location": { "type": "string", "minLength": 1 },
        "evidence_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retention_until": { "type": "string", "format": "date-time" },
        "deletion_owner": { "type": "string", "minLength": 1 }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials_revoked", "processes_stopped", "persistence_removed", "rollback_or_recovery_result", "residual_risk_owner", "c3po_cepo_handoff_v1"],
      "properties": {
        "credentials_revoked": { "const": true },
        "processes_stopped": { "const": true },
        "persistence_removed": { "const": true },
        "rollback_or_recovery_result": { "type": "string", "minLength": 1 },
        "residual_risk_owner": { "const": "roberto" },
        "c3po_cepo_handoff_v1": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state", "previous_record_ref", "previous_record_digest_sha256", "changed_at", "changed_by_identity", "transition_evidence"],
      "properties": {
        "from_state": { "type": ["string", "null"], "enum": [null, "DRAFT", "AUTHORIZED", "ACTIVE", "CONTAINED", "RECOVERED", "CLOSED", "REVOKED"] },
        "to_state": { "enum": ["DRAFT", "AUTHORIZED", "ACTIVE", "CONTAINED", "RECOVERED", "CLOSED", "REVOKED"] },
        "previous_record_ref": { "type": ["string", "null"], "pattern": "^git-sha256://[0-9a-f]{40}/records/[A-Za-z0-9._-]+\\.json$" },
        "previous_record_digest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "changed_at": { "type": "string", "format": "date-time" },
        "changed_by_identity": { "type": "string", "minLength": 1 },
        "transition_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "robertoApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "identity", "approved_scope_actions_digest_sha256", "evidence", "approved_at", "expires_at", "revoked_at", "revoked_by_identity"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "identity": { "const": "roberto" },
        "approved_scope_actions_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "revoked_by_identity": { "type": ["string", "null"] }
      }
    },
    "terezaApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "identity", "approved_scope_actions_digest_sha256", "evidence", "approved_at", "expires_at", "revoked_at", "revoked_by_identity"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "identity": { "const": "tereza" },
        "approved_scope_actions_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "revoked_by_identity": { "type": ["string", "null"] }
      }
    },
    "killSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "channel_or_endpoint", "operator_identity", "operator_must_differ_from_executor", "tested_at", "test_valid_until", "test_result", "automatic_stop_on_control_loss"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "channel_or_endpoint": { "type": "string", "minLength": 1 },
        "operator_identity": { "type": "string", "minLength": 1 },
        "operator_must_differ_from_executor": { "const": true },
        "tested_at": { "type": "string", "format": "date-time" },
        "test_valid_until": { "type": "string", "format": "date-time" },
        "test_result": { "const": "PASS" },
        "automatic_stop_on_control_loss": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "DRAFT" } }, "required": ["state"] },
      "then": {
        "allOf": [
          { "not": { "required": ["authorization"] } },
          { "not": { "required": ["closure"] } }
        ],
        "properties": {
          "transition": {
            "properties": {
              "from_state": { "type": "null" },
              "to_state": { "const": "DRAFT" },
              "previous_record_ref": { "type": "null" },
              "previous_record_digest_sha256": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["AUTHORIZED", "ACTIVE", "CONTAINED", "RECOVERED"] } }, "required": ["state"] },
      "then": {
        "required": ["authorization"],
        "not": { "required": ["closure"] },
        "properties": {
          "transition": {
            "properties": {
              "from_state": { "type": "string" },
              "previous_record_ref": { "type": "string", "minLength": 1 },
              "previous_record_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "authorization": {
            "properties": {
              "roberto_approval": {
                "properties": {
                  "revoked_at": { "type": "null" },
                  "revoked_by_identity": { "type": "null" }
                }
              },
              "tereza_approval": {
                "properties": {
                  "revoked_at": { "type": "null" },
                  "revoked_by_identity": { "type": "null" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["CLOSED", "REVOKED"] } }, "required": ["state"] },
      "then": {
        "required": ["authorization", "closure"],
        "properties": {
          "transition": {
            "properties": {
              "from_state": { "type": "string" },
              "previous_record_ref": { "type": "string", "minLength": 1 },
              "previous_record_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "REVOKED" } }, "required": ["state"] },
      "then": {
        "properties": {
          "authorization": {
            "anyOf": [
              {
                "properties": {
                  "roberto_approval": {
                    "properties": {
                      "revoked_at": { "type": "string", "format": "date-time" },
                      "revoked_by_identity": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              {
                "properties": {
                  "tereza_approval": {
                    "properties": {
                      "revoked_at": { "type": "string", "format": "date-time" },
                      "revoked_by_identity": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "personal_data": { "const": true }
            },
            "required": ["personal_data"]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "doneda_gate": { "const": "PASS" }
            }
          }
        }
      }
    }
  ]
}
