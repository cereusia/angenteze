{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cereusia.local/schemas/r2d2-context-verification-receipt.schema.json",
  "title": "R2D2 independent context verification receipt v1",
  "$comment": "Closed documentary contract. Cryptographic identity verification remains a runtime gate and is not activated by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema",
    "verification_id",
    "context_id",
    "context_ref",
    "verified_context_digest_sha256",
    "source_bundle_ref",
    "verified_source_bundle_digest_sha256",
    "extractor_id",
    "extractor_digest_sha256",
    "verifier_identity",
    "verifier_credential_fingerprint_sha256",
    "trust_policy_id",
    "trust_policy_digest_sha256",
    "authentication_evidence_ref",
    "authentication_evidence_digest_sha256",
    "verified_at",
    "result",
    "receipt_digest_sha256"
  ],
  "properties": {
    "receipt_schema": { "const": "r2d2-context-verification-receipt-v1" },
    "verification_id": { "type": "string", "minLength": 1 },
    "context_id": { "type": "string", "minLength": 1 },
    "context_ref": { "type": "string", "pattern": "^store://contexts/[A-Za-z0-9._-]+\\.json$" },
    "verified_context_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_bundle_ref": { "type": "string", "pattern": "^store://context-sources/[A-Za-z0-9._-]+\\.json$" },
    "verified_source_bundle_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extractor_id": { "const": "r2d2-context-extractor-v1" },
    "extractor_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verifier_identity": { "type": "string", "minLength": 1 },
    "verifier_credential_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trust_policy_id": { "const": "r2d2-context-trust-policy-v1" },
    "trust_policy_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authentication_evidence_ref": { "type": "string", "pattern": "^store://identity-attestations/[A-Za-z0-9._-]+\\.json$" },
    "authentication_evidence_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verified_at": { "type": "string", "format": "date-time" },
    "result": { "const": "PASS" },
    "receipt_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
